# ElevenLabs TTS (recommended for MRX Voice)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Server — REQUIRED for real users
GEMINI_API_KEY=your_google_ai_api_key_here
JWT_SECRET=change-this-to-a-long-random-string-in-production
PORT=3001
CLIENT_ORIGIN=http://localhost:3000

# Google OAuth (same Client ID for server + Vite)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Optional Gemini model overrides
# GEMINI_MODEL_PRO=gemini-2.5-pro
# GEMINI_MODEL_FLASH=gemini-2.5-flash
# GEMINI_MODEL_TTS=gemini-2.5-flash-preview-tts

# Admin (comma-separated emails; super admin is always dnainform@gmail.com)
ADMIN_EMAILS=dnainform@gmail.com

# ─── Production on Vercel (do this before inviting users) ───

# 1. Persistent database — add Upstash Redis from Vercel Marketplace (free tier OK)
#    Vercel auto-fills these when you connect the integration:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 2. Site URL — or leave empty; app uses https://YOUR-PROJECT.vercel.app automatically
# CLIENT_ORIGIN=https://mrx-lemon.vercel.app

# 3. AI — get key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=...

# 4. JWT — generate: openssl rand -base64 32
# JWT_SECRET=...

# Optional: Stripe subscription (without it, users get 7-day trial via mock checkout)
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_ID=
# STRIPE_PUBLISHABLE_KEY=

# Local file DB only (NOT persistent on Vercel serverless)
# DATABASE_PATH=./data/mrx.json
