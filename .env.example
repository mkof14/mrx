# ElevenLabs TTS (recommended for MRX Voice)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Server
GEMINI_API_KEY=your_google_ai_api_key_here
JWT_SECRET=change-this-to-a-long-random-string-in-production
PORT=3001
CLIENT_ORIGIN=http://localhost:3000

# Google OAuth (same Client ID for server + Vite)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Optional Gemini model overrides
# GEMINI_MODEL_PRO=gemini-2.5-pro
# GEMINI_MODEL_FLASH=gemini-2.5-flash
# GEMINI_MODEL_TTS=gemini-2.5-flash-preview-tts

# Optional: custom database file path (defaults to ./data/mrx.json)
# DATABASE_PATH=./data/mrx.json

# Vercel production (ephemeral — fine for staging/final tests)
# DATABASE_PATH=/tmp/mrx.json
# CLIENT_ORIGIN=https://your-app.vercel.app
